generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// Base hébergée sur Supabase (décision du 25/11). DATABASE_URL passe par le pooler
// Supavisor (port 6543, pgbouncer=true) pour l'application ; DIRECT_URL (port 5432)
// sert uniquement aux migrations Prisma, qui ne passent pas par un pooler de transactions.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  DEPARTED
}

// Reflète les trois listes du fichier de suivi papier/Excel (Hommes, Femmes,
// Enfants) fourni par le client (26/11), pour garder la même répartition à
// la migration des données.
enum MemberCategory {
  MAN
  WOMAN
  CHILD
}

enum CheckInMethod {
  MANUAL
  QR_CODE
}

enum ProfessionalStatus {
  EMPLOYEE
  ENTREPRENEUR
  STUDENT
  UNEMPLOYED
  OTHER
}

enum ResidencyStatus {
  VALID
  EXPIRED
  NEVER_HAD
}

enum Role {
  SUPER_ADMIN
  PASTOR
  TREASURER
  COMMUNICATION
  ADMIN
  DEPARTMENT_LEADER
  GROUP_LEADER
  SECRETARY
  SOCIAL_SUPPORT
  ATTENDANCE_MANAGER
  READ_ONLY
}

enum EventType {
  SERVICE
  MEETING
  CONFERENCE
  OTHER
}

enum ContentType {
  NEWS
  EVENT
  PAGE
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

model Member {
  id                 String                 @id @default(cuid())
  firstName          String
  lastName           String
  phone              String?
  email              String?
  neighborhood       String?
  // Null quand la personne n'apparaît dans aucune des listes Hommes / Femmes /
  // Enfants du fichier importé : l'administrateur la renseigne ensuite.
  category           MemberCategory?
  birthDate          DateTime?
  notes              String?
  membershipStatus   MembershipStatus       @default(ACTIVE)
  departedAt         DateTime?
  departureReason    String?
  professionalStatus ProfessionalStatus?
  memberships        DepartmentMembership[]
  groupId            String?
  group              Group?                 @relation("GroupMembers", fields: [groupId], references: [id], onDelete: SetNull)
  ledGroup           Group?                 @relation("GroupLeader")
  attendances        Attendance[]
  pledges            Pledge[]
  socialSupport      SocialSupportRecord?
  user               User?
  // Jeton stable encodé dans le QR code personnel du membre (section "calcul
  // automatique des présences", décision du 26/11) : scanné à l'entrée, il
  // identifie le membre sans exposer son identifiant de base de données.
  qrToken            String?                @unique
  // Fonctions dans l'église (Ancien, Assistant pasteur, Diacre, Protocole...),
  // distinctes de la fonction tenue dans un département.
  functions          String[]               @default([])
  submissions        MemberSubmission[]
  stockMovements     StockMovement[]
  supportRequests    SupportRequest[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

model Department {
  id          String                 @id @default(cuid())
  name        String
  description String?
  mission     String?
  imageUrl    String?
  isPublished Boolean                @default(false)
  memberships DepartmentMembership[]
  groups      Group[]
}

// Une personne peut servir dans plusieurs départements, avec une fonction
// propre à chacun (liste des ouvriers du fichier de suivi).
model DepartmentMembership {
  id           String     @id @default(cuid())
  memberId     String
  member       Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  role         String?

  @@unique([memberId, departmentId])
}

model Group {
  id             String      @id @default(cuid())
  name           String
  neighborhood   String?
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  leaderMemberId String?     @unique
  leader         Member?     @relation("GroupLeader", fields: [leaderMemberId], references: [id], onDelete: SetNull)
  members        Member[]    @relation("GroupMembers")
}

model ServiceEvent {
  id                     String       @id @default(cuid())
  title                  String
  type                   EventType    @default(SERVICE)
  startAt                DateTime
  isPublic               Boolean      @default(false)
  attendances            Attendance[]
  // Horodatage du dernier envoi du rapport de présence (section "génère un
  // rapport qui envoie le message") ; null tant qu'aucun rapport n'a été
  // généré pour ce culte.
  attendanceReportSentAt DateTime?
  // Personnes qui ont suivi le culte en ligne (saisi lors du pointage).
  onlineCount            Int?
}

// Une ligne par membre et par culte/événement, créée seulement à la présence
// (scan QR ou pointage manuel) : le nombre de présents par événement est donc
// un simple COUNT, jamais recalculé ni stocké en double (section "calcul
// automatique des présences").
model Attendance {
  id            String        @id @default(cuid())
  memberId      String
  member        Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  eventId       String
  event         ServiceEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  present       Boolean       @default(true)
  checkedInAt   DateTime      @default(now())
  checkInMethod CheckInMethod @default(MANUAL)

  @@unique([memberId, eventId])
}

model Campaign {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  pledges   Pledge[]
  // Suivi de la dernière modification (campagne ou un de ses engagements).
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String?
}

// Les engagements sont souvent pris par un foyer ("Couple KIFILA") plutôt que
// par un membre seul : donorName porte le nom tel qu'écrit, memberId reste
// optionnel. Montant vide = "à confirmer".
model Pledge {
  id             String   @id @default(cuid())
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  memberId       String?
  member         Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  donorName      String
  amountPromised Decimal?
  // Montant déjà reçu ; « payé » quand il atteint le montant promis.
  amountPaid     Decimal?
  // Numéro pour la relance WhatsApp quand le donateur n'a pas de fiche membre.
  phone          String?
  followUpDone   Boolean  @default(false)
  // Relances WhatsApp envoyées depuis l'intranet (date de la dernière, nombre).
  lastReminderAt DateTime?
  reminderCount  Int      @default(0)
  comment        String?
  updatedAt      DateTime @default(now()) @updatedAt
  updatedBy      String?
}

// Table physiquement séparée de Member : la règle d'accès (rôle Accompagnement
// social uniquement) est appliquée en Row Level Security Postgres, pas que dans le
// code applicatif, pour qu'une requête mal écrite ne puisse jamais faire fuiter ces
// données (cahier des charges CCR, section 5).
model SocialSupportRecord {
  id                  String          @id @default(cuid())
  memberId            String          @unique
  member              Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  residencyStatus     ResidencyStatus
  documentNumber      String?
  hasRenewalDocuments Boolean?
  renewalDifficulty   String?
  updatedAt           DateTime        @updatedAt
}

// Les mots de passe sont gérés par Supabase Auth (verrouillage, réinitialisation) :
// cette table ne porte que le rôle, rattaché au compte par l'e-mail.
model User {
  id          String    @id @default(cuid())
  email       String    @unique
  role        Role
  memberId    String?   @unique
  member      Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  // Dernière activité vue sur l'intranet (mise à jour au plus toutes les
  // minutes), pour savoir qui est en ligne, d'où et avec quel appareil.
  lastSeenAt      DateTime?
  lastSeenIp      String?
  lastSeenCity    String?
  lastSeenCountry String?
  lastSeenDevice  String?
  lastSessionId   String?
  // Jeton secret du lien d'abonnement à l'agenda personnel (fichier .ics) :
  // les tâches assignées apparaissent dans Google Agenda, Outlook ou iPhone.
  calendarToken String? @unique
  tasks         Task[]  @relation("TaskAssignee")
  createdTasks  Task[]  @relation("TaskCreator")
  authEvents    AuthEvent[]
}

enum AuthEventType {
  LINK_SENT
  LINK_REFUSED
  LOGIN
  LOGIN_FAILED
  LOGOUT
}

// Journal des connexions et déconnexions à l'intranet, consultable par le
// super administrateur uniquement : date, lieu approximatif (déduit de
// l'adresse IP par Vercel) et appareil utilisé. Conservé douze mois.
model AuthEvent {
  id        String        @id @default(cuid())
  type      AuthEventType
  email     String
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  ip        String?
  city      String?
  region    String?
  country   String?
  userAgent String?
  device    String?
  createdAt DateTime      @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// Tâche assignée à un responsable (personne ayant un accès à l'intranet),
// avec une échéance qui sert de rappel dans son agenda.
model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueAt       DateTime
  assigneeId  String
  assignee    User      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  doneAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([assigneeId, dueAt])
}

// Les actualités ne sont modifiées que par les administrateurs depuis l'intranet
// (confirmé le 25/11) : photo (coverImageUrl) et texte (body) vivent sur le même
// enregistrement, publiées ensemble via le workflow de la section 6.
model Content {
  id             String        @id @default(cuid())
  type           ContentType
  title          String
  slug           String        @unique
  coverImageUrl  String?
  body           String
  seoTitle       String?
  seoDescription String?
  status         ContentStatus @default(DRAFT)
  authorId       String
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum SubmissionStatus {
  PENDING
  MERGED
  CREATED
  REJECTED
}

// Fiche remplie par un membre depuis le formulaire public : elle n'écrase
// jamais la base directement. Un administrateur la fusionne avec une fiche
// existante, en crée une nouvelle, ou la rejette.
model MemberSubmission {
  id                 String              @id @default(cuid())
  firstName          String
  lastName           String
  phone              String?
  email              String?
  birthDate          DateTime?
  neighborhood       String?
  category           MemberCategory?
  professionalStatus ProfessionalStatus?
  functions          String[]            @default([])
  // [{ departmentId, role }]
  departments        Json                @default("[]")
  message            String?
  status             SubmissionStatus    @default(PENDING)
  memberId           String?
  member             Member?             @relation(fields: [memberId], references: [id], onDelete: SetNull)
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime            @default(now())
}

// Stock du social : denrées et équipements reçus puis distribués. Chaque
// entrée ou sortie est tracée (date et heure, qui, à qui) ; la quantité en
// stock est recalculée à chaque mouvement.
model StockItem {
  id        String          @id @default(cuid())
  name      String          @unique
  unit      String
  quantity  Decimal         @default(0)
  position  Int             @default(100)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  movements StockMovement[]
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

model StockMovement {
  id                  String            @id @default(cuid())
  itemId              String
  item                StockItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type                StockMovementType
  quantity            Decimal
  balanceAfter        Decimal
  // Bénéficiaire d'une sortie : membre de l'église ou personne extérieure.
  beneficiaryMemberId String?
  beneficiaryMember   Member?           @relation(fields: [beneficiaryMemberId], references: [id], onDelete: SetNull)
  beneficiaryName     String?
  requestId           String?
  request             SupportRequest?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  // Entrée : provenance du don ; sortie : précision libre.
  note                String?
  byEmail             String
  at                  DateTime          @default(now())

  @@index([itemId, at])
}

enum SupportRequestStatus {
  NEW
  DONE
  REJECTED
}

// Demande de soutien (alimentaire) envoyée depuis le site public.
model SupportRequest {
  id            String               @id @default(cuid())
  firstName     String
  lastName      String
  phone         String
  email         String?
  neighborhood  String?
  householdSize Int?
  needs         String[]             @default([])
  message       String?
  status        SupportRequestStatus @default(NEW)
  memberId      String?
  member        Member?              @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  handledAt     DateTime?
  handledBy     String?
  movements     StockMovement[]

  @@index([status, createdAt])
}
